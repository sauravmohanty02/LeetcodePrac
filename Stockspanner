class StockSpanner {
public:
    stack <pair<int,int>> st;
    StockSpanner() {
        
    }
    
    int next(int price) 
    {
        int cnt= 1;
        while(!st.empty() && st.top().first<= price)
        {
            int val= st.top().first;
            int add= st.top().second;
            cnt+= add;
            st.pop();
        }

        st.push({price,cnt});

        return cnt;
    }
};

